<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoolTrack.TestEntryPage"
             Title="Enter Test Results"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Log New Pool Test"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource DeepNavy}" />

            <!-- Input Card -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">

                    <!-- pH -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="pH"
                                   FontSize="13"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource DeepNavy}" />
                            <Label Grid.Column="1"
                                   Text="no unit"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />
                        </Grid>
                        <Border Stroke="{StaticResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource FieldSurface}"
                                Padding="0">
                            <Entry x:Name="pHEntry"
                                   Placeholder="e.g. 7.4"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"/>
                        </Border>
                        <Label Text="Ideal 7.2 to 7.8"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>

                    <!-- Total Chlorine -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total Chlorine"
                                   FontSize="13"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource DeepNavy}" />
                            <Label Grid.Column="1"
                                   Text="ppm"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />
                        </Grid>
                        <Border Stroke="{StaticResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource FieldSurface}"
                                Padding="0">
                            <Entry x:Name="chlorineEntry"
                                   Placeholder="e.g. 2.5"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"/>
                        </Border>
                        <Label Text="Ideal 1 to 4 ppm"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>

                    <!-- Free Chlorine -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Free Chlorine"
                                   FontSize="13"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource DeepNavy}" />
                            <Label Grid.Column="1"
                                   Text="ppm"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />
                        </Grid>
                        <Border Stroke="{StaticResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource FieldSurface}"
                                Padding="0">
                            <Entry x:Name="chlorineFreeEntry"
                                   Placeholder="e.g. 2.0"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"/>
                        </Border>
                        <Label Text="Ideal 1 to 3 ppm"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>

                    <!-- Alkalinity -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total Alkalinity"
                                   FontSize="13"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource DeepNavy}" />
                            <Label Grid.Column="1"
                                   Text="ppm"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />
                        </Grid>
                        <Border Stroke="{StaticResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource FieldSurface}"
                                Padding="0">
                            <Entry x:Name="alkalinityEntry"
                                   Placeholder="e.g. 100"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"/>
                        </Border>
                        <Label Text="Ideal 80 to 120 ppm"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>

                    <!-- Calcium -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Calcium Hardness"
                                   FontSize="13"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource DeepNavy}" />
                            <Label Grid.Column="1"
                                   Text="ppm"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />
                        </Grid>
                        <Border Stroke="{StaticResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource FieldSurface}"
                                Padding="0">
                            <Entry x:Name="calciumEntry"
                                   Placeholder="e.g. 250"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"/>
                        </Border>
                        <Label Text="Ideal 200 to 400 ppm"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button Text="Save Test"
                    Command="{Binding SaveTestCommand}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>