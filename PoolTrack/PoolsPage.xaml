<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:poolTrack="clr-namespace:PoolTrack"
             x:Class="PoolTrack.PoolsPage"
             Title="Pools"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Pools"
                   Style="{StaticResource SectionHeader}"
                   HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Pools}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No pools yet"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource TextMuted}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="poolTrack:PoolItemViewModel">
                        <Border Style="{StaticResource Card}"
                                Margin="0,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ActivateCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource DeepNavy}" />
                                    <Label Grid.Column="1"
                                           Text="Active"
                                           FontSize="12"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource StatusOkText}"
                                           IsVisible="{Binding IsActive}" />
                                </Grid>
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Rename"
                                            FontSize="13"
                                            Padding="12,6"
                                            MinimumHeightRequest="36"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary}"
                                            Command="{Binding RenameCommand}" />
                                    <Button Text="Delete"
                                            FontSize="13"
                                            Padding="12,6"
                                            MinimumHeightRequest="36"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource StatusAlertText}"
                                            Command="{Binding DeleteCommand}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Add Pool"
                    Command="{Binding AddPoolCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
