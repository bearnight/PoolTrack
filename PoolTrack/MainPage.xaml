<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
             x:Class="PoolTrack.MainPage"
             Title="Dashboard">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="{Binding ActivePoolName}"
               Style="{StaticResource SectionHeader}"
               HorizontalOptions="Center" />

        <controls:Border Stroke="{StaticResource CardBorder}" StrokeThickness="1" BackgroundColor="{StaticResource CardSurface}" Padding="15">
            <controls:Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </controls:Border.StrokeShape>
            <VerticalStackLayout>
                <Label Text="Latest Test" FontSize="13" TextColor="{StaticResource TextMuted}"/>
                <Label Text="{Binding LatestTest}" FontSize="16"/>
            </VerticalStackLayout>
        </controls:Border>

        <Button Text="Enter New Test" Command="{Binding NavigateToTestEntry}"/>
        <Button Text="Manage Pools" Clicked="OnManagePoolsClicked"/>
    </VerticalStackLayout>

</ContentPage>
